# ========================================================
# .gitignore — Portfolio Sacha Guitter & Project Manager
# ========================================================

# 1. Dépendances Node.js (racine et sous-dossiers)
node_modules/
**/node_modules/
.pnp
.pnp.js

# 2. Builds, compilations et distributions
dist/
dist-ssr/
*.local
.vite/
.eslintcache
.cache/

# 3. Binaires lourds et fichiers de compilation (Node SEA)
*.exe
**/*.exe
*.blob
**/*.blob
sea-prep.blob
bundle.js
**/bundle.js

# 4. Fichiers volumineux (> 100 Mo interdits par GitHub)
pdf/Portfolio-Sacha-Guitter-Edition-Papier.pdf
pdf/*-Edition-Papier*.pdf
dist/pdf/Portfolio-Sacha-Guitter-Edition-Papier.pdf

# 5. Fichiers d'environnement, secrets et mots de passe
.pm-auth.json
**/.pm-auth.json
*.auth.json
**/*.auth.json
config.mail.php
.env
.env.local
.env.*.local

# 6. Sauvegardes de données
json/backups/
**/backups/

# 7. Journaux et logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 8. Fichiers temporaires et sauvegardes d'éditeurs
*.tmp
*.temp
*.bak
*.swp
*~

# 9. Fichiers système (Windows / macOS)
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# 10. Éditeurs & IDEs
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 11. Configuration et caches locaux de l'agent IA
.agents/
GEMINI.md
